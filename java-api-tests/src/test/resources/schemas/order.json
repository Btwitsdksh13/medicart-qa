{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "status", "paymentStatus", "items", "subtotal", "discount", "delivery", "total", "history"],
  "properties": {
    "id": {"type": "string", "pattern": "^ORD[0-9A-F]{8}$"},
    "status": {"enum": ["PLACED", "CONFIRMED", "PACKED", "SHIPPED", "DELIVERED", "CANCELLED"]},
    "paymentStatus": {"enum": ["PAID", "PENDING", "REFUND_INITIATED"]},
    "total": {"type": "number", "minimum": 0},
    "items": {"type": "array", "minItems": 1},
    "history": {"type": "array", "minItems": 1}
  }
}
